# Environment variables — copia in .env e riempi i valori
# .env è ignorato da git, .env.example no

# Supabase (newsletter subscription)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# EmailJS (contact form)
EMAILJS_PUBLIC_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=

# Umami Cloud (analytics privacy-first, no cookie)
# Il valore si trova nella dashboard Umami Cloud → Settings → Websites → Website ID
ANALYTICS_WEBSITE_ID=
# Lascia vuoto per usare il default Umami Cloud CDN, oppure specifica un mirror
ANALYTICS_SCRIPT_URL=https://cloud.umami.is/script.js

# Gemini API (AI widget nel blog)
GEMINI_API_KEY=
