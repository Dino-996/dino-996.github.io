---
layout: base.njk
---

{% block head_extra %}
  {% if image %}
    <link rel="preload" href="{{ image }}" as="image" fetchpriority="high">
  {% endif %}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/themes/prism-tomorrow.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.28/dist/katex.min.css" integrity="sha384-Wsr4Nh3yrvMf2KCebJchRJoVo1gTU6kcP05uRSh5NV3sj9+a8IomuJoQzf3sMq4T" crossorigin="anonymous">

  <!-- SEO: JSON-LD Article schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": {{ title | dump }},
    "url": "{{ site.url }}{{ page.url }}",
    {% if date %}"datePublished": "{{ page.date | dateIso }}",{% endif %}
    {% if updatedAt %}"dateModified": "{{ updatedAt | dateIso }}",{% endif %}
    "author": {
      "@type": "Person",
      "name": "{{ author | default(site.author) }}"
    },
    {% if image %}"image": "{{ site.url }}{{ image }}",{% endif %}
    "publisher": {
      "@type": "Person",
      "name": "{{ site.author }}"
    }
  }
  </script>

  <!-- SEO: JSON-LD BreadcrumbList schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {% set crumbsList = page.url | breadcrumbs %}
      {% for crumb in crumbsList %}
      {
        "@type": "ListItem",
        "position": {{ loop.index }},
        "name": {{ crumb.label | dump }}{% if crumb.url %},
        "item": "{{ site.url }}{{ crumb.url }}"{% endif %}
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  </script>
{% endblock %}

<div class="reading-progress-bar" id="reading-progress-bar"></div>

<div class="post-article-layout">
  <aside class="toc-sidebar" id="toc-sidebar">
    <div class="toc-card">
      <div class="toc-title">
        <span>Indice</span>
        <button id="toc-collapse-btn" class="toc-collapse-btn hide-desktop" aria-label="Collassa indice">▾</button>
      </div>
      <ul class="toc-list" id="toc-list"></ul>
    </div>
  </aside>

  <div class="post-article-content">
    <!-- Mobile TOC toggle -->
    <div class="toc-mobile-wrapper" id="toc-mobile-toggle-wrapper">
      <button id="toc-toggle" class="toc-mobile-btn" aria-expanded="false" aria-controls="toc-mobile">
        <span>Indice</span>
        <span id="toc-chevron" class="toc-chevron">▾</span>
      </button>
      <nav id="toc-mobile" class="toc-mobile-nav" style="display: none;" aria-label="Indice articolo">
        <ul id="toc-list-mobile" class="toc-list"></ul>
      </nav>
    </div>

    <header class="post-header">
      {% set postCourse = courses | courseForUrl(page.url) %}
      {% set crumbs = [] %}
      {% set crumbs = crumbs.concat([{ label: "Home", url: "/" }]) %}
      {% if postCourse %}
        {% set crumbs = crumbs.concat([{ label: "Percorsi", url: "/courses/" }]) %}
        {% set crumbs = crumbs.concat([{ label: postCourse.name, url: "/courses/" + postCourse.slug + "/" }]) %}
      {% else %}
        {% set crumbs = crumbs.concat([{ label: "Blog", url: "/blog/" }]) %}
        {% if tags and tags.length > 0 %}
          {% set tagSlug = tags[0] %}
          {% if tagSlug != "post" %}
            {% set crumbs = crumbs.concat([{ label: tagSlug, url: "/tags/" + tagSlug + "/" }]) %}
          {% endif %}
        {% endif %}
      {% endif %}
      {% set crumbs = crumbs.concat([{ label: title }]) %}
      {% include "breadcrumb.njk" %}

      <h1>{{ title }}</h1>

      {% if description %}
      <p class="post-description">{{ description }}</p>
      {% endif %}

      <div class="post-meta">
        <img src="{{ authorAvatar | default('/assets/img/avatar/dino-996-32.png') }}" alt="{{ author | default('Davide Sabia') }}" class="avatar" width="24" height="24">
        <span>{{ author | default('Davide Sabia') }}</span>
        <span class="post-meta-dot">·</span>
        <span>Pubblicato il {{ postDate | dateHuman }}</span>
        <span class="post-meta-dot">·</span>
        <span class="reading-time"></span>
        {% if updatedAt and (updatedAt | dateDay) > (postDate | dateDay) %}
          <span class="post-meta-dot">·</span>
          <span>Aggiornato il {{ updatedAt | dateHuman }}</span>
        {% endif %}
      </div>
    </header>

    {% if image %}
    <figure class="post-hero">
      <img src="{{ image }}"
           alt="{{ imageAlt | default('Immagine di copertina') }}"
           class="post-hero-image"
           fetchpriority="high">
      {% if imageAlt %}
      <figcaption class="post-hero-caption">{{ imageAlt }}</figcaption>
      {% endif %}
    </figure>
    {% endif %}

    <article class="post-layout">
      {% if tldr[title] %}
      <div class="tldr-box">
        <div class="tldr-label">Riassunto generato automaticamente tramite intelligenza artificiale:</div>
        <p class="mb-0" style="font-size: 0.9375rem; line-height: 1.6;">{{ tldr[title].tldr }}</p>
      </div>
      {% endif %}

      <section class="content">
        {{ content | markdownBlock | safe }}
      </section>

      <!-- Disclaimer AI -->
      <footer class="mt-4 pt-3 border-top">
        <p class="text-muted small mb-0">
          <em>Articolo scritto con il supporto di LLM per la formattazione e la struttura del codice.</em>
        </p>
      </footer>

    </article>

    <!-- Share & Tags -->
    <div class="post-layout post-section">
      <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
        <div class="d-flex flex-wrap gap-2">
          {% if strapiTags %}
            {% for t in strapiTags.split(",") %}
              {% set cleanTag = t | trim %}
              {% if cleanTag and cleanTag != "posts" %}
              <a href="/tags/{{ cleanTag | slugify }}/" class="badge badge-outline">{{ cleanTag }}</a>
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>
        <div class="d-flex gap-2 align-items-center share-block">
          <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ site.url ~ page.url | urlencode }}" target="_blank" rel="noopener" class="btn btn-outline btn-sm share-btn" aria-label="Condividi su LinkedIn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/></svg>
            Condividi su LinkedIn
          </a>
          <a href="https://twitter.com/intent/tweet?text={{ title | urlencode }}&url={{ site.url ~ page.url | urlencode }}" target="_blank" rel="noopener" class="btn btn-outline btn-sm share-btn" aria-label="Condividi su X">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>
            Condividi su X
          </a>
        </div>
      </div>
    </div>

    <!-- Prev / Next -->
    {% set prevPostUrl = post.prevPostUrl %}
    {% set prevPostTitle = post.prevPostTitle %}
    {% set nextPostUrl = post.nextPostUrl %}
    {% set nextPostTitle = post.nextPostTitle %}
    {% if prevPostUrl or nextPostUrl %}
    <div class="post-layout post-section post-section-sm">
      <nav class="d-flex justify-content-between gap-2" aria-label="Navigazione articoli">
        <div class="article-nav-half">
          {% if prevPostUrl %}
          <a href="{{ prevPostUrl }}" class="btn btn-outline btn-sm article-nav-btn">
            <span class="d-block small article-nav-label">← Precedente</span>
            <span class="d-block article-nav-title">{{ prevPostTitle }}</span>
          </a>
          {% endif %}
        </div>
        <div class="article-nav-half article-nav-right">
          {% if nextPostUrl %}
          <a href="{{ nextPostUrl }}" class="btn btn-outline btn-sm article-nav-btn article-nav-btn-right">
            <span class="d-block small article-nav-label">Successivo →</span>
            <span class="d-block article-nav-title">{{ nextPostTitle }}</span>
          </a>
          {% endif %}
        </div>
      </nav>
    </div>
    {% endif %}

    <!-- Potrebbe interessarti -->
    {% set related = posts | relatedPosts(page.url, tags) %}
    {% if related | length > 0 %}
    <section class="related-posts" aria-labelledby="related-posts-heading">
      <h2 id="related-posts-heading" class="post-layout">Potrebbe interessarti</h2>
      <div class="related-posts-grid post-layout">
        {% for rp in related %}
        <a href="{{ rp.url }}" class="related-post-card">
          {% if rp.image %}
          <div class="related-post-image">
            <img src="{{ rp.image }}" alt="{{ rp.imageAlt | default(rp.title) }}" loading="lazy">
          </div>
          {% endif %}
          <div class="related-post-content">
            {% if rp.strapiTags %}
              {% set firstTag = rp.strapiTags.split(",")[0] | trim %}
              {% if firstTag and firstTag != "post" and firstTag != "posts" %}
              <span class="badge">{{ firstTag }}</span>
              {% endif %}
            {% endif %}
            <h3 class="related-post-title">{{ rp.title }}</h3>
            {% if rp.date %}
            <time class="related-post-date">{{ rp.date | dateHuman }}</time>
            {% endif %}
          </div>
        </a>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    <!-- Commenti -->
    <h2 class="post-layout comment-heading">Commenti</h2>
    <div class="post-layout giscus-wrapper">
      <script>
        (function () {
          var theme = window.__bsTheme || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          var script = document.createElement('script');
          script.src = 'https://giscus.app/client.js';
          script.setAttribute('data-repo', 'Dino-996/dino-996.github.io');
          script.setAttribute('data-repo-id', 'R_kgDORNULOw');
          script.setAttribute('data-category', 'Announcements');
          script.setAttribute('data-category-id', 'DIC_kwDORNULO84C24dr');
          script.setAttribute('data-mapping', 'pathname');
          script.setAttribute('data-strict', '0');
          script.setAttribute('data-reactions-enabled', '1');
          script.setAttribute('data-emit-metadata', '0');
          script.setAttribute('data-input-position', 'top');
          script.setAttribute('data-theme', theme);
          script.setAttribute('data-lang', 'it');
          script.setAttribute('data-loading', 'lazy');
          script.setAttribute('crossorigin', 'anonymous');
          script.async = true;
          document.currentScript.replaceWith(script);
        })();
      </script>
      <noscript>
        <div style="text-align: center; padding: 24px; color: var(--secondary); font-size: 0.875rem;">
          Per visualizzare i commenti è necessario abilitare JavaScript.
          <br>
          <a href="https://github.com/Dino-996/dino-996.github.io/discussions" target="_blank" rel="noopener">Discuti su GitHub Discussions →</a>
        </div>
      </noscript>
    </div>
  </div>
</div>

{% block scripts %}
  <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/prism.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/plugins/autoloader/prism-autoloader.min.js" defer
    data-autoloader-path="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/"></script>
  <script src="https://cdn.jsdelivr.net/npm/katex@0.16.28/dist/katex.min.js" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/katex@0.16.28/dist/contrib/auto-render.min.js" crossorigin="anonymous"></script>
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      renderMathInElement(document.body, {
        delimiters: [
          {left: '$$', right: '$$', display: true},
          {left: '$', right: '$', display: false},
          {left: '\\(', right: '\\)', display: false},
          {left: '\\[', right: '\\]', display: true}
        ]
      });
    });
  </script>
{% endblock %}
