---
layout: base.njk
---

{% block head_extra %}
  {% if image %}
    <link rel="preload" href="{{ image }}" as="image" fetchpriority="high">
  {% endif %}
{% endblock %}

<div class="reading-progress-bar" id="reading-progress-bar"></div>

<!-- Post Header -->
<header class="post-header">
  {% if strapiTags %}
    {% set topTag = strapiTags.split(",") | first | trim %}
    {% if topTag and topTag != "posts" %}
    <span class="badge badge-category category">{{ topTag }}</span>
    {% endif %}
  {% endif %}
  <h1>{{ title }}</h1>
  <div class="post-meta">
    <img src="{{ authorAvatar | default('/assets/img/avatar/dino-996-32.png') }}" alt="{{ author }}" class="avatar" width="32" height="32">
    <span>{{ author | default('Davide Sabia') }}</span>
    <span>·</span>
    <time datetime="{{ postDate | dateIso }}">{{ postDate | dateHuman }}</time>
    <span class="reading-time"></span>
    {% if updatedAt and (updatedAt | dateIso) != (postDate | dateIso) %}
      <span>·</span>
      <time datetime="{{ updatedAt | dateIso }}">Aggiornato: {{ updatedAt | dateHuman }}</time>
    {% endif %}
  </div>
  {% if image %}
  <img src="{{ image }}"
       alt="{{ imageAlt | default('Immagine di copertina') }}"
       class="post-image"
       fetchpriority="high">
  {% endif %}
</header>

<!-- Mobile ToC toggle -->
<div class="post-layout" style="margin-bottom: 16px;">
  <div class="hide-desktop">
    <button id="toc-toggle" class="btn btn-outline btn-sm" style="width: 100%; display: flex; justify-content: space-between; align-items: center;">
      <span>Indice</span>
      <span id="toc-chevron" style="transition: transform 0.2s;">▾</span>
    </button>
    <div id="toc-mobile" style="display: none; margin-top: 8px;">
      <div class="toc-card">
        <ul class="toc-list" id="toc-list-mobile"></ul>
      </div>
    </div>
  </div>
</div>

<div class="post-layout-wrapper">
  <article class="post-layout">
    {% if tldr[title] %}
    <div class="tldr-box">
      <div class="tldr-label">In breve</div>
      <p class="mb-0" style="font-size: 0.9375rem; line-height: 1.6;">{{ tldr[title].tldr }}</p>
    </div>
    {% endif %}

    <section class="content">
      {{ content | markdownBlock | safe }}
    </section>
  </article>

  <aside class="toc-sidebar hide-mobile" id="toc-sidebar">
    <div class="toc-card">
      <div class="toc-title">Indice</div>
      <ul class="toc-list" id="toc-list"></ul>
    </div>
  </aside>
</div>

<!-- Share & Tags -->
<div class="post-layout" style="padding: 24px 0; margin-top: 24px; border-top: 1px solid var(--border-subtle);">
  <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
    <div class="d-flex flex-wrap gap-2">
      {% if strapiTags %}
        {% for t in strapiTags.split(",") %}
          {% set cleanTag = t | trim %}
          {% if cleanTag and cleanTag != "posts" %}
          <a href="/tags/{{ cleanTag | slugify }}/" class="badge badge-outline">{{ cleanTag }}</a>
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>
    <div class="d-flex gap-2">
      <span class="font-label-sm" style="color: var(--on-surface-variant);">Condividi</span>
      <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ site.url ~ page.url | urlencode }}" target="_blank" rel="noopener" aria-label="LinkedIn" style="color: var(--secondary);">in</a>
      <a href="https://twitter.com/intent/tweet?text={{ title | urlencode }}&url={{ site.url ~ page.url | urlencode }}" target="_blank" rel="noopener" aria-label="X" style="color: var(--secondary);">𝕏</a>
    </div>
  </div>
</div>

<!-- Prev / Next -->
{% set prevPostUrl = post.prevPostUrl %}
{% set prevPostTitle = post.prevPostTitle %}
{% set nextPostUrl = post.nextPostUrl %}
{% set nextPostTitle = post.nextPostTitle %}
{% if prevPostUrl or nextPostUrl %}
<div class="post-layout" style="padding: 24px 0; margin-top: 24px; border-top: 1px solid var(--border-subtle);">
  <nav class="d-flex justify-content-between" aria-label="Navigazione articoli">
    <div>
      {% if prevPostUrl %}
      <a href="{{ prevPostUrl }}" class="btn btn-outline btn-sm" style="text-align: left; max-width: 250px;">
        <span class="d-block small">← Precedente</span>
        <span class="d-block" style="font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{{ prevPostTitle }}</span>
      </a>
      {% endif %}
    </div>
    <div style="text-align: right;">
      {% if nextPostUrl %}
      <a href="{{ nextPostUrl }}" class="btn btn-outline btn-sm" style="text-align: right; max-width: 250px;">
        <span class="d-block small">Successivo →</span>
        <span class="d-block" style="font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{{ nextPostTitle }}</span>
      </a>
      {% endif %}
    </div>
  </nav>
</div>
{% endif %}

<!-- Comments -->
<div class="post-layout giscus-wrapper">
  <script>
    (function () {
      const saved = localStorage.getItem('bs-theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = (saved === 'dark' || saved === 'light') ? saved : (prefersDark ? 'dark' : 'light');
      const script = document.createElement('script');
      script.src = 'https://giscus.app/client.js';
      script.setAttribute('data-repo', 'Dino-996/dino-996.github.io');
      script.setAttribute('data-repo-id', 'R_kgDORNULOw');
      script.setAttribute('data-category', 'Announcements');
      script.setAttribute('data-category-id', 'DIC_kwDORNULO84C24dr');
      script.setAttribute('data-mapping', 'pathname');
      script.setAttribute('data-strict', '0');
      script.setAttribute('data-reactions-enabled', '1');
      script.setAttribute('data-emit-metadata', '0');
      script.setAttribute('data-input-position', 'top');
      script.setAttribute('data-theme', theme);
      script.setAttribute('data-lang', 'it');
      script.setAttribute('data-loading', 'lazy');
      script.setAttribute('crossorigin', 'anonymous');
      script.async = true;
      document.currentScript.replaceWith(script);
    })();
  </script>
  <noscript>
    <div style="text-align: center; padding: 24px; color: var(--secondary); font-size: 0.875rem;">
      Per visualizzare i commenti è necessario abilitare JavaScript.
      <br>
      <a href="https://github.com/Dino-996/dino-996.github.io/discussions" target="_blank" rel="noopener">Discuti su GitHub Discussions →</a>
    </div>
  </noscript>
</div>
