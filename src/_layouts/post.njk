---
layout: base.njk
---

{% block head_extra %}
  {% if image %}
    <link rel="preload" href="{{ image }}" as="image" fetchpriority="high">
  {% endif %}
{% endblock %}

<div class="reading-progress-bar" id="reading-progress-bar"></div>

<div class="post-article-layout">
  <aside class="toc-sidebar" id="toc-sidebar">
    <div class="toc-card">
      <div class="toc-title">
        <span>Indice</span>
        <button id="toc-collapse-btn" class="toc-collapse-btn" aria-label="Collassa indice">▾</button>
      </div>
      <ul class="toc-list" id="toc-list"></ul>
    </div>
  </aside>

  <div class="post-article-content">
    <!-- Mobile TOC toggle -->
    <div class="toc-mobile-wrapper hide-desktop" id="toc-mobile-toggle-wrapper">
      <button id="toc-toggle" class="toc-mobile-btn" aria-expanded="false" aria-controls="toc-mobile">
        <span>Indice</span>
        <span id="toc-chevron" class="toc-chevron">▾</span>
      </button>
      <nav id="toc-mobile" class="toc-mobile-nav" style="display: none;" aria-label="Indice articolo">
        <ul id="toc-list-mobile" class="toc-list"></ul>
      </nav>
    </div>

    <header class="post-header">
      <div class="post-breadcrumb">
        <a href="/">Home</a>
        <span class="post-breadcrumb-sep">»</span>
        {% set postCourse = courses | courseForUrl(page.url) %}
        {% if postCourse %}
        <a href="/courses/">Percorsi</a>
        <span class="post-breadcrumb-sep">»</span>
        <a href="/courses/{{ postCourse.slug }}/">{{ postCourse.name }}</a>
        {% else %}
        <a href="/blog/">Blog</a>
        {% endif %}
      </div>

      <h1>{{ title }}</h1>

      {% if description %}
      <p class="post-description">{{ description }}</p>
      {% endif %}

      <div class="post-meta">
        <img src="{{ authorAvatar | default('/assets/img/avatar/dino-996-32.png') }}" alt="{{ author | default('Davide Sabia') }}" class="avatar" width="24" height="24">
        <span>{{ author | default('Davide Sabia') }}</span>
        <span class="post-meta-dot">·</span>
        <span>Pubblicato il {{ postDate | dateHuman }}</span>
        <span class="post-meta-dot">·</span>
        <span class="reading-time"></span>
        {% if updatedAt and (updatedAt | dateIso) != (postDate | dateIso) %}
        <span class="post-meta-dot">·</span>
        <span>Aggiornato: {{ updatedAt | dateHuman }}</span>
        {% endif %}
      </div>
    </header>

    {% if image %}
    <img src="{{ image }}"
         alt="{{ imageAlt | default('Immagine di copertina') }}"
         class="post-hero-image"
         fetchpriority="high">
    {% endif %}

    <article class="post-layout">
      {% if tldr[title] %}
      <div class="tldr-box">
        <div class="tldr-label">In breve</div>
        <p class="mb-0" style="font-size: 0.9375rem; line-height: 1.6;">{{ tldr[title].tldr }}</p>
      </div>
      {% endif %}

      <section class="content">
        {{ content | markdownBlock | safe }}
      </section>
    </article>

    <!-- Share & Tags -->
    <div class="post-layout" style="padding: 24px 0; margin-top: 32px; border-top: 1px solid var(--border-subtle);">
      <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
        <div class="d-flex flex-wrap gap-2">
          {% if strapiTags %}
            {% for t in strapiTags.split(",") %}
              {% set cleanTag = t | trim %}
              {% if cleanTag and cleanTag != "posts" %}
              <a href="/tags/{{ cleanTag | slugify }}/" class="badge badge-outline">{{ cleanTag }}</a>
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>
        <div class="d-flex gap-2 align-items-center">
          <span style="font-family: var(--font-label); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; line-height: 1; color: var(--on-surface-variant);">Condividi</span>
          <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ site.url ~ page.url | urlencode }}" target="_blank" rel="noopener" aria-label="LinkedIn" style="font-family: var(--font-label); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.05em; line-height: 1; color: var(--secondary);">IN</a>
          <a href="https://twitter.com/intent/tweet?text={{ title | urlencode }}&url={{ site.url ~ page.url | urlencode }}" target="_blank" rel="noopener" aria-label="X" style="font-family: var(--font-label); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.05em; line-height: 1; color: var(--secondary);">𝕏</a>
        </div>
      </div>
    </div>

    <!-- Prev / Next -->
    {% set prevPostUrl = post.prevPostUrl %}
    {% set prevPostTitle = post.prevPostTitle %}
    {% set nextPostUrl = post.nextPostUrl %}
    {% set nextPostTitle = post.nextPostTitle %}
    {% if prevPostUrl or nextPostUrl %}
    <div class="post-layout" style="padding: 24px 0; margin-top: 24px; border-top: 1px solid var(--border-subtle);">
      <nav class="d-flex flex-wrap justify-content-between gap-2" aria-label="Navigazione articoli">
        <div style="min-width: 0; max-width: 50%; flex: 1 1 auto;">
          {% if prevPostUrl %}
          <a href="{{ prevPostUrl }}" class="btn btn-outline btn-sm" style="text-align: left; max-width: 100%; overflow: hidden; display: block;">
            <span class="d-block small" style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">← Precedente</span>
            <span class="d-block" style="font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{{ prevPostTitle }}</span>
          </a>
          {% endif %}
        </div>
        <div style="min-width: 0; max-width: 50%; text-align: right; flex: 1 1 auto;">
          {% if nextPostUrl %}
          <a href="{{ nextPostUrl }}" class="btn btn-outline btn-sm" style="text-align: right; max-width: 100%; overflow: hidden; display: block;">
            <span class="d-block small" style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">Successivo →</span>
            <span class="d-block" style="font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{{ nextPostTitle }}</span>
          </a>
          {% endif %}
        </div>
      </nav>
    </div>
    {% endif %}

    <!-- Comments -->
    <h2 class="post-layout" style="font-size: 1.25rem; margin-top: 48px; margin-bottom: 0;">Commenti</h2>
    <div class="post-layout giscus-wrapper">
      <script>
        (function () {
          var theme = window.__bsTheme || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          var script = document.createElement('script');
          script.src = 'https://giscus.app/client.js';
          script.setAttribute('data-repo', 'Dino-996/dino-996.github.io');
          script.setAttribute('data-repo-id', 'R_kgDORNULOw');
          script.setAttribute('data-category', 'Announcements');
          script.setAttribute('data-category-id', 'DIC_kwDORNULO84C24dr');
          script.setAttribute('data-mapping', 'pathname');
          script.setAttribute('data-strict', '0');
          script.setAttribute('data-reactions-enabled', '1');
          script.setAttribute('data-emit-metadata', '0');
          script.setAttribute('data-input-position', 'top');
          script.setAttribute('data-theme', theme);
          script.setAttribute('data-lang', 'it');
          script.setAttribute('data-loading', 'lazy');
          script.setAttribute('crossorigin', 'anonymous');
          script.async = true;
          document.currentScript.replaceWith(script);
        })();
      </script>
      <noscript>
        <div style="text-align: center; padding: 24px; color: var(--secondary); font-size: 0.875rem;">
          Per visualizzare i commenti è necessario abilitare JavaScript.
          <br>
          <a href="https://github.com/Dino-996/dino-996.github.io/discussions" target="_blank" rel="noopener">Discuti su GitHub Discussions →</a>
        </div>
      </noscript>
    </div>
  </div>
</div>
