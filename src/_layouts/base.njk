<!DOCTYPE html>
<html lang="it">

  <head>
    {% include "head.njk" %}
    {% block head_extra %}{% endblock %}

    <!-- EmailJS -->
    <script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>

    <!-- Supabase JS client -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>

    <script>
      window.SUPABASE_URL = {{ supabaseUrl | json | safe }};
      window.SUPABASE_ANON_KEY = {{ supabaseAnonKey | json | safe }};
      window.EMAILJS_PUBLIC_KEY = {{ emailjsPublicKey | json | safe }};
      window.EMAILJS_SERVICE_ID = {{ emailjsServiceId | json | safe }};
      window.EMAILJS_TEMPLATE_ID = {{ emailjsTemplateId | json | safe }};
    </script>

    <!-- OS theme detection — runs before body render to prevent flash -->
    <script>
      (function() {
        var theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-bs-theme', theme);
        window.__bsTheme = theme;
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
          var t = e.matches ? 'dark' : 'light';
          document.documentElement.setAttribute('data-bs-theme', t);
          window.__bsTheme = t;
        });
      })();
    </script>
  </head>

  <body>
    <a href="#main-content" class="skip-link">Vai al contenuto principale</a>

    {% include "navbar.njk" %}

    <div class="header-spacer"></div>

    <main id="main-content" class="container" style="flex: 1;">
      {{ content | safe }}
    </main>

    {% include "footer.njk" %}

{% block scripts %}{% endblock %}

    <!-- Scroll to top -->
    <button id="scroll-top-btn" class="scroll-top-btn" aria-label="Torna su">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 15l-6-6-6 6"/></svg>
    </button>

    <!-- AI assistant widget -->
    <div id="ai-assistant" class="ai-assistant-wrapper">
      <button id="ai-toggle" class="ai-btn-pulse" aria-label="Apri assistente virtuale basato su intelligenza artificiale">
        <span aria-hidden="true">🦖</span>
        <span class="ai-toggle-badge" aria-hidden="true">IA</span>
      </button>

      <div id="ai-chat-window" class="ai-card" hidden>
        <div class="ai-card-header">
          <div class="d-flex align-items-center gap-2">
            <div class="ai-avatar-mini"><span aria-hidden="true">🦖</span></div>
            <span id="ai-title" class="fw-bold">dino</span>
            <span class="ai-badge" aria-label="Assistente basato su intelligenza artificiale">IA</span>
          </div>
          <button type="button" id="ai-close" class="ai-close-btn" aria-label="Chiudi">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
          </button>
        </div>

        <div id="ai-messages" class="ai-chat-body" aria-live="polite">
          <div class="ai-welcome-msg">
            Ciao! Sono dino, l'assistente IA di questo blog. Posso aiutarti a trovare informazioni tra i post?
          </div>
        </div>

        <div class="ai-card-footer">
          <label for="ai-input" class="visually-hidden">Chiedimi qualcosa</label>
          <input id="ai-input" type="text" placeholder="Chiedimi qualcosa..." autocomplete="off">
          <button id="ai-send">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- AI assistant widget -->
    <script src="/assets/js/ai-widget.js" defer></script>

    <!-- Scroll to top logic -->
    <script>
      (function() {
        var btn = document.getElementById('scroll-top-btn');
        if (!btn) return;
        var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var toggleVisibility = function() {
          var visible = window.scrollY > 400;
          btn.classList.toggle('visible', visible);
          btn.setAttribute('tabindex', visible ? '0' : '-1');
        };
        window.addEventListener('scroll', toggleVisibility, { passive: true });
        toggleVisibility();
        btn.addEventListener('click', function() {
          window.scrollTo({ top: 0, behavior: prefersReducedMotion ? 'auto' : 'smooth' });
        });
      })();
    </script>

    <!-- main.js -->
    <script src="/assets/js/main.js" defer></script>
  </body>

</html>
