---
layout: page.njk
title: About
---

<section class="mb-5">
  <div class="d-flex align-items-center gap-4">
    <div class="d-inline-flex align-items-center justify-content-center rounded-4 flex-shrink-0"
         style="width: 72px; height: 72px; background: linear-gradient(135deg, var(--primary-color), #0b5ed7);">
      <span class="fw-bold text-white" style="font-size: 1.6rem; font-family: monospace;">{;}</span>
    </div>
    <div>
      <h1 class="fw-bold mb-2">{{ title }}</h1>
      <p class="lead text-muted mb-0" style="max-width: 600px;">
        Informatico orientato alla costruzione di software solido,
        con interesse per architettura backend e sicurezza applicativa.
      </p>
    </div>
  </div>
</section>

<div class="row g-4">
  <!-- Stack -->
  <div class="col-12 col-md-6">
    <div class="card h-100 border">
      <div class="card-body p-4">
        <div class="d-flex align-items-center gap-3 mb-3">
          <div class="d-flex align-items-center justify-content-center rounded-3"
               style="width: 44px; height: 44px; background: var(--primary-light);">
            <i class="bi bi-code-slash fs-4 text-primary"></i>
          </div>
          <h3 class="h5 mb-0">Stack</h3>
        </div>
        <div class="mb-3">
          <p class="small text-muted mb-1">Backend</p>
          <div class="d-flex flex-wrap gap-1">
            <span class="badge bg-light text-body border">Java</span>
            <span class="badge bg-light text-body border">Spring Boot</span>
            <span class="badge bg-light text-body border">PostgreSQL</span>
          </div>
        </div>
        <div>
          <p class="small text-muted mb-1">Frontend</p>
          <div class="d-flex flex-wrap gap-1">
            <span class="badge bg-light text-body border">Angular</span>
            <span class="badge bg-light text-body border">TypeScript</span>
            <span class="badge bg-light text-body border">Bootstrap</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Blog Stats -->
  <div class="col-12 col-md-6">
    <div class="card h-100 border">
      <div class="card-body d-flex flex-column p-4">
        <div class="d-flex align-items-center gap-3 mb-3">
          <div class="d-flex align-items-center justify-content-center rounded-3"
               style="width: 44px; height: 44px; background: var(--primary-light);">
            <i class="bi bi-bar-chart-line fs-4 text-primary"></i>
          </div>
          <h3 class="h5 mb-0">In numeri</h3>
        </div>
        <div class="row g-3 text-center">
          <div class="col-4">
            <div class="fw-bold fs-4 text-primary">{{ collections.posts.length }}</div>
            <div class="text-muted small">Articoli</div>
          </div>
          <div class="col-4">
            <div class="fw-bold fs-4 text-primary">{{ collections.tagList | length }}</div>
            <div class="text-muted small">Tag</div>
          </div>
          <div class="col-4">
            <div class="fw-bold fs-4 text-primary">2020</div>
            <div class="text-muted small">Dal</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Contatti -->
  <div class="col-12">
    <div class="card border">
      <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-3 p-4">
        <div class="d-flex align-items-center gap-3">
          <div class="d-flex align-items-center justify-content-center rounded-3"
               style="width: 44px; height: 44px; background: var(--primary-light);">
            <i class="bi bi-envelope-fill fs-4 text-primary"></i>
          </div>
          <div>
            <h3 class="h5 mb-0">Contatti</h3>
            <p class="text-muted small mb-0">Disponibile per collaborazioni e progetti.</p>
          </div>
        </div>
        <a href="mailto:davidesabia22@gmail.com" class="btn btn-outline-primary rounded">
          <i class="bi bi-envelope-fill me-1"></i>Email
        </a>
      </div>
    </div>
  </div>
</div>