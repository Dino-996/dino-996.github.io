---
pagination:
  data: posts
  size: 1
  alias: strapiPost
  addAllPagesToCollections: true
layout: post.njk
permalink: "blog/{{ strapiPost.slug | slugify }}/index.html"
tags:
  - posts
eleventyComputed:
  title: "{{ strapiPost.title }}"
  description: "{{ strapiPost.description }}"
  postDate: "{{ strapiPost.date }}"
  image: "{{ strapiPost.image }}"
  imageAlt: "{{ strapiPost.imageAlt }}"
  strapiTags: "{{ strapiPost.strapiTags }}"
---

{{ strapiPost.content | markdownBlock | safe }}