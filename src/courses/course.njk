---
layout: page.njk
permalink: "/courses/{{ course.slug }}/index.html"
eleventyExcludeFromCollections: true
pagination:
  data: courses
  size: 1
  alias: course
---

{% from "article-card.njk" import listCard %}

{% block head_extra %}
<script>document.title = {{ course.name | json | safe }} + " · " + {{ site.title | json | safe }};</script>
{% endblock %}

<div class="mb-6">
  <div class="mb-2">
    <a href="/courses/" class="text-muted small" style="text-decoration: none;">← Tutti i corsi</a>
  </div>
  <h1 class="font-headline-lg mb-2">{{ course.name }}</h1>
  <p class="text-muted mb-0">{{ course.postCount }} post</p>
</div>

{% if course.posts.length > 0 %}
  {% for post in course.posts.reverse() %}
  {{ listCard(post, { compact: true, truncate: 300, image: "right" }) }}
  {% endfor %}
{% endif %}
