---
layout: page.njk
title: Blog
description: Articoli e appunti
pagination:
  data: collections.posts
  size: 5
  alias: posts
permalink: "{% if pagination.pageNumber > 0 %}/blog/page/{{ pagination.pageNumber + 1 }}/index.html{% else %}/blog/index.html{% endif %}"
---

<div class="mb-6">
  <h1 class="font-headline-lg mb-2">Blog</h1>
  <p class="text-muted">Esplora tutti gli articoli</p>
</div>

<!-- Search -->
<div class="search-bar">
  <label for="search-input" class="visually-hidden">Cerca articoli</label>
  <input type="search" id="search-input" placeholder="Cerca un articolo per titolo..." autocomplete="off">
  <button id="search-button">Cerca</button>
</div>

<div id="search-results" hidden aria-live="polite"></div>

<!-- Post list -->
<section id="posts-list">
  {% for post in posts %}
  <article class="article-item article-item-horizontal">
    <div class="article-item-body">
    {% if post.data.strapiTags %}
      {% set topTag = post.data.strapiTags.split(",") | first | trim %}
      {% if topTag and topTag != "posts" %}
      <a href="/tags/{{ topTag | slugify }}/" class="badge badge-category article-item-category">{{ topTag }}</a>
      {% endif %}
    {% endif %}
    <h2 class="article-item-title">
      <a href="{{ post.url }}">{{ post.data.title }}</a>
    </h2>
    {% if post.data.description %}
    <p class="article-item-excerpt">{{ post.data.description | truncate(200) }}</p>
    {% endif %}
    <div class="article-item-meta">
      <time datetime="{{ post.data.postDate | dateIso }}">{{ post.data.postDate | dateHuman }}</time>
      {% if post.data.author %}
       · {{ post.data.author }}
      {% endif %}
    </div>
    </div>
    {% if post.data.image %}
    <a href="{{ post.url }}" class="article-item-image-wrap article-item-image-right">
      <img src="{{ post.data.image }}"
           alt="{{ post.data.imageAlt | default(post.data.title) }}"
           class="article-item-image"
           loading="lazy">
    </a>
    {% endif %}
  </article>
  {% endfor %}
</section>

<!-- Search results (rendered by JS) -->

<!-- Pagination -->
{% if pagination.pages.length > 1 %}
<nav class="pagination-bar" aria-label="Navigazione pagine blog">
  <div>
    {% if pagination.previousPageHref %}
      <a href="{{ pagination.previousPageHref }}" class="btn btn-outline btn-sm">
        Precedente
      </a>
    {% endif %}
  </div>
  <div class="pagination-info">
    {{ pagination.pageNumber + 1 }} / {{ pagination.pages.length }}
  </div>
  <div>
    {% if pagination.nextPageHref %}
      <a href="{{ pagination.nextPageHref }}" class="btn btn-outline btn-sm">
        Successivo
      </a>
    {% endif %}
  </div>
</nav>
{% endif %}
