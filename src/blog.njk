---
layout: page.njk
title: Blog
description: Articoli e appunti
pagination:
  data: collections.posts
  size: 5
  alias: posts
permalink: "{% if pagination.pageNumber > 0 %}/blog/page/{{ pagination.pageNumber + 1 }}/index.html{% else %}/blog/index.html{% endif %}"
---

<div class="d-flex align-items-center gap-3 mb-4">
  <div class="d-flex align-items-center justify-content-center rounded-3"
       style="width: 48px; height: 48px; background: var(--primary-light);">
    <i class="bi bi-journal-text fs-4 text-primary"></i>
  </div>
  <div>
    <h1 class="fw-bold mb-0">{{ title }}</h1>
    <p class="text-muted small mb-0">Esplora tutti gli articoli</p>
  </div>
</div>

<!-- Search -->
<div class="mb-4">
  <div class="input-group rounded-pill overflow-hidden" id="search-group">
    <span class="input-group-text bg-body border-0 ps-3">
      <i class="bi bi-search text-muted"></i>
    </span>
    <input type="search" id="search-input"
           class="form-control border-0 ps-1"
           placeholder="Cerca un articolo per titolo..."
           aria-label="Cerca articoli"
           autocomplete="off">
    <button id="search-button" class="btn btn-primary border-0 px-3" type="button">
      Cerca
    </button>
  </div>
  <div id="search-results" class="mt-3" hidden></div>
</div>

<!-- Post list -->
<section id="posts-list" class="row g-4">
  {% for post in posts %}
  <div class="col-12">
    <article class="card h-100 overflow-hidden border">
      <div class="row g-0 h-100">
        {% if post.data.image %}
        <div class="col-md-4 overflow-hidden">
          <img src="{{ post.data.image }}"
               alt="{{ post.data.imageAlt if post.data.imageAlt else post.data.title }}"
               class="img-fluid w-100 h-100"
               style="object-fit: cover; min-height: 240px;">
        </div>
        <div class="col-md-8">
        {% else %}
        <div class="col-12">
        {% endif %}
          <div class="card-body d-flex flex-column p-4">
            <div>
              <h2 class="h4 card-title mb-2">
                <a href="{{ post.url }}">{{ post.data.title }}</a>
              </h2>
              <time class="text-muted small d-block mb-3" datetime="{{ post.data.postDate | dateIso }}">
                <i class="bi bi-calendar3 me-1"></i>{{ post.data.postDate | dateHuman }}
              </time>
              {% if post.data.description %}
                <p class="text-muted small mb-3">
                  {{ post.data.description | truncate(250) | safe }}
                </p>
              {% endif %}
              {% if post.data.strapiTags %}
                <div class="d-flex flex-wrap gap-1 mb-3">
                  {% for t in post.data.strapiTags.split(",") %}
                    {% set cleanTag = t | trim %}
                    {% if cleanTag and cleanTag != "posts" %}
                      <a href="/tags/{{ cleanTag | slug }}/"
                         class="badge border text-decoration-none"
                         style="color: var(--bs-body-color); border-color: var(--bs-border-color) !important;">
                        {{ cleanTag }}
                      </a>
                    {% endif %}
                  {% endfor %}
                </div>
              {% endif %}
            </div>
            <div class="mt-auto text-end">
              <a href="{{ post.url }}" class="btn btn-primary btn-sm rounded">
                Leggi l'articolo <i class="bi bi-arrow-right ms-1"></i>
              </a>
            </div>
          </div>
        </div>
      </div>
    </article>
  </div>
  {% endfor %}
</section>

<!-- Pagination -->
<nav id="pagination" class="pagination-nav mt-5" aria-label="Navigazione pagine blog">
  <div class="d-flex justify-content-between align-items-center">
    <div>
      {% if pagination.previousPageHref %}
        <a href="{{ pagination.previousPageHref }}" class="btn btn-outline-primary">
          <i class="bi bi-arrow-left me-1"></i>Precedente
        </a>
      {% else %}
        <span></span>
      {% endif %}
    </div>
    <div class="text-muted small fw-medium">
      Pagina {{ pagination.pageNumber + 1 }} di {{ pagination.pages.length }}
    </div>
    <div>
      {% if pagination.nextPageHref %}
        <a href="{{ pagination.nextPageHref }}" class="btn btn-outline-primary">
          Successivo <i class="bi bi-arrow-right ms-1"></i>
        </a>
      {% else %}
        <span></span>
      {% endif %}
    </div>
  </div>
</nav>