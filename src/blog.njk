---
layout: page.njk
title: Blog
description: Articoli e appunti
pagination:
  data: collections.posts
  size: 5
  alias: posts
permalink: "{% if pagination.pageNumber > 0 %}/blog/page/{{ pagination.pageNumber + 1 }}/index.html{% else %}/blog/index.html{% endif %}"
---

{% from "article-card.njk" import listCard %}

<div class="mb-6">
  <h1 class="font-headline-lg mb-2">Blog</h1>
  <p class="text-muted">Esplora tutti gli articoli</p>
</div>

<!-- Search -->
<div class="search-bar">
  <label for="search-input" class="visually-hidden">Cerca articoli</label>
  <input type="search" id="search-input" placeholder="Cerca un articolo per titolo..." autocomplete="off">
  <button id="search-button">Cerca</button>
</div>

<div id="search-results" hidden aria-live="polite"></div>

<!-- Post list -->
<section id="posts-list">
  {% for post in posts %}
  {{ listCard(post, { image: "right", truncate: 200, showAuthor: true }) }}
  {% endfor %}
</section>

<!-- Search results (rendered by JS) -->

<!-- Pagination -->
{% if pagination.pages.length > 1 %}
<nav id="pagination" class="pagination-bar" aria-label="Navigazione pagine blog">
  <div>
    {% if pagination.previousPageHref %}
      <a href="{{ pagination.previousPageHref }}" class="btn btn-outline btn-sm">
        Precedente
      </a>
    {% endif %}
  </div>
  <div class="pagination-info">
    {{ pagination.pageNumber + 1 }} / {{ pagination.pages.length }}
  </div>
  <div>
    {% if pagination.nextPageHref %}
      <a href="{{ pagination.nextPageHref }}" class="btn btn-outline btn-sm">
        Successivo
      </a>
    {% endif %}
  </div>
</nav>
{% endif %}
