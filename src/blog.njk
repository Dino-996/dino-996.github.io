---
layout: layouts/page.njk
title: Blog
description: Articoli e appunti
pagination:
  data: collections.posts
  size: 5
  alias: posts
permalink: "/blog/{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber + 1 }}/{% endif %}index.html"
---

<h1>
  <i class="text-primary bi bi-journal-text me-2"></i>
  <span style="color: var(--bs-body-color)"> {{ title }} </span>
</h1>

<div class="mb-5">
  <div class="input-group shadow-sm">
    <span class="input-group-text border-end-0">
      <i class="bi bi-search" style="color: var(--bs-body-color)"></i>
    </span>
    <input
      type="search"
      id="search-input"
      class="form-control border-start-0 ps-1"
      placeholder="Cerca un articolo..."
    >
    <button id="search-button" class="btn btn-primary px-4" type="button">
      Cerca
    </button>
  </div>
</div>

<div id="search-results" class="row g-4" hidden></div>

<section id="posts-list" class="row g-4">
  {% for post in posts %}
  <div class="col-12">
    <article class="card h-100 shadow-sm border-0 overflow-hidden">
      <div class="row g-0 h-100">
        
        {% if post.data.image %}
        <div class="col-md-4 lg:h-75 md:h-100">
          <img 
            src="{{ post.data.image }}" 
            alt="{{ post.data.title }}" 
            class="d-block w-100 h-100" 
            style="object-fit: cover; min-height: 220px;"
          >
        </div>
        {% endif %}

        <div class="col-md-{% if post.data.image %}8{% else %}12{% endif %} d-flex flex-column">
          <div class="card-body d-flex flex-column h-100 p-4">
            
            <div class="grow">
              <h2 class="h4 card-title mb-2 fw-bold">
                <a href="{{ post.url }}" class="text-decoration-none" style="color: var(--bs-body-color)">{{ post.data.title }}</a>
              </h2>

              <div class="d-flex align-items-center mb-3">
                <div class="d-inline-flex align-items-center gap-2" style="color: var(--bs-body-color)">
                  <img 
                    src="{{ post.data.authorAvatar | default('/assets/images/default-avatar.svg') }}" 
                    alt="{{ post.data.author }}" 
                    class="rounded-circle"
                    width="32"
                    height="32"
                    style="object-fit: cover;">
                 <span class="small">{{ post.data.author }}</span>
                </div>
                <time class="text-muted small d-block ms-auto">
                  <i class="bi bi-calendar3 me-1"></i>{{ post.data.date | dateHuman }}
                </time>
              </div>
              
              <div class="mb-3 small" style="color: var(--bs-body-color)">
                {{ post.data.description | truncate(160) }}
              </div>

              {# STAG #}
              {% if post.data.strapiTags %}
              <div class="d-flex flex-wrap gap-2 mb-3">
                {% set tagList = post.data.strapiTags.split(',') %}
                {% for tag in tagList %}
                  {% set t = tag | trim %}
                  {% if t and t != "posts" %}
                    <a href="/tags/{{ t | slugify }}/" class="badge bg-light border text-decoration-none fw-normal" style="color: var(--bs-body-color)">
                      {{ t }}
                    </a>
                  {% endif %}
                {% endfor %}
              </div>
              {% endif %}
            </div>

            <div class="text-end mt-auto pt-3 border-top">
              <a href="{{ post.url }}" class="btn btn-primary btn-sm px-3 rounded-2">
                Leggi l'articolo <i class="bi bi-arrow-right ms-1"></i>
              </a>
            </div>
          </div>
        </div>

      </div>
    </article>
  </div>
  {% endfor %}
</section>

<nav id="pagination" class="mt-5 border-top pt-4">
  <div class="d-flex justify-content-between align-items-center">
    <div>
      {% if pagination.href.previous %}
        <a href="{{ pagination.href.previous }}" class="btn btn-outline-primary btn-sm rounded-2">
          <i class="bi bi-arrow-left"></i>
        </a>
      {% endif %}
    </div>
    
    <div class="text-muted small">
      Pagina {{ pagination.pageNumber + 1 }} di {{ pagination.pages.length }}
    </div>
    
    <div>
      {% if pagination.href.next %}
        <a href="{{ pagination.href.next }}" class="btn btn-outline-primary btn-sm rounded-2">
          <i class="bi bi-arrow-right"></i>
        </a>
      {% endif %}
    </div>
  </div>
</nav>