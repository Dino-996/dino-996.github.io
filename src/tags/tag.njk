---
pagination:
  data: collections.tagList
  size: 1
  alias: tag
permalink: /tags/{{ tag | slugify }}/
layout: layouts/page.njk
title: "Tag: {{ tag }}"
---

<h1 class="mb-1">
  <i class="text-primary bi bi-tag me-2"></i>
  <span style="color: var(--bs-body-color)">{{ tag }}</span>
</h1>
<p class="text-muted mb-4 small">{{ collections.postsByTag[tag].length }} articolo/i</p>

<section class="row g-4">
  {% for post in collections.postsByTag[tag] | reverse %}
  <div class="col-12">
    <article class="card h-100 shadow-sm border-0">
      <div class="card-body d-flex flex-column p-4">
        <h2 class="h4 mb-1">
          <a href="{{ post.url }}" class="text-decoration-none" style="color: var(--bs-body-color)">
            {{ post.data.title }}
          </a>
        </h2>
        <time class="text-muted small mb-3">
          <i class="bi bi-calendar3 me-1"></i>{{ post.data.date | dateHuman }}
        </time>
        {% if post.data.description %}
        <p class="text-muted small mb-0">{{ post.data.description | truncate(160) }}</p>
        {% endif %}
        <div class="text-end mt-auto pt-3">
          <a href="{{ post.url }}" class="btn btn-primary btn-sm">
            Leggi l'articolo <i class="bi bi-arrow-right ms-1"></i>
          </a>
        </div>
      </div>
    </article>
  </div>
  {% endfor %}
</section>