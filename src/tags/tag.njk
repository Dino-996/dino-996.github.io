---
layout: page.njk
title: "Tag: {{ tag }}"
permalink: "/tags/{{ tag | slugify }}/index.html"
eleventyExcludeFromCollections: true
pagination:
  data: collections.tagList
  size: 1
  alias: tag
---

<div class="mb-6">
  <div class="mb-1">
    <a href="/blog/" class="text-muted small" style="text-decoration: none;">← Torna al blog</a>
  </div>
  <h1 class="font-headline-lg mb-1">
    Tag: <span style="color: var(--primary);">{{ tag }}</span>
  </h1>
  <p class="text-muted small mb-0">Post con tag "{{ tag }}"</p>
</div>

{% set taggedPosts = [] %}
{% for post in collections.posts %}
  {% set allTags = (post.data.strapiTags or "").split(",") %}
  {% if tag in allTags %}
    {% set taggedPosts = (taggedPosts.push(post), taggedPosts) %}
  {% endif %}
{% endfor %}

{% if taggedPosts.length > 0 %}
  {% for post in taggedPosts %}
    <article class="article-item" style="padding-left: 0; padding-right: 0;">
      <h2 class="article-item-title" style="font-size: 1.125rem;">
        <a href="{{ post.url }}">{{ post.data.title }}</a>
      </h2>
      {% if post.data.description %}
      <p class="article-item-excerpt">{{ post.data.description | truncate(200) }}</p>
      {% endif %}
      <div class="article-item-meta">
        <time datetime="{{ post.data.postDate | dateIso }}">{{ post.data.postDate | dateHuman }}</time>
      </div>
      <div class="d-flex flex-wrap gap-1" style="margin-top: 8px;">
        {% set currentTags = (post.data.strapiTags or "").split(",") %}
        {% for t in currentTags %}
          {% set cleanTag = t | trim %}
          {% if cleanTag != "posts" and cleanTag != tag and cleanTag != "" %}
            <a href="/tags/{{ cleanTag | slugify }}/" class="badge badge-outline" style="font-size: 0.625rem;">{{ cleanTag }}</a>
          {% endif %}
        {% endfor %}
      </div>
    </article>
  {% endfor %}
{% else %}
  <div style="text-align: center; padding: 64px 16px;">
    <p class="text-muted mb-3">Nessun articolo trovato per questo tag.</p>
    <a href="/blog/" class="btn btn-outline">Torna al blog</a>
  </div>
{% endif %}
