---
layout: layouts/page.njk
title: "Tag: {{ tag }}"
permalink: "/tags/{{ tag | slugify }}/index.html"
eleventyExcludeFromCollections: true
pagination:
  data: collections.tagsList
  size: 1
  alias: tag
---

<div class="mb-4">
  <h1>
    <i class="bi bi-tag-fill text-primary me-2"></i>Tag: <span class="text-primary">{{ tag }}</span>
  </h1>
  <p class="text-muted">Post con tag "{{ tag }}"</p>
</div>

<ul class="list-unstyled">
<!-- DEBUG: {{ collections.posts[0].data.strapiTags | dump }} -->
  {% set taggedPosts = [] %}
  {% for post in collections.posts %}
    {% set allTags = post.data.strapiTags.split(",") %}
    {% if tag in allTags %}
      {% set taggedPosts = (taggedPosts.push(post), taggedPosts) %}
    {% endif %}
  {% endfor %}

  {% if taggedPosts.length > 0 %}
    {% for post in taggedPosts | reverse %}
      <li class="mb-4">
        <article class="card shadow-sm">
          <div class="card-body">
            <h2 class="h4 mb-2">
              <a href="{{ post.url }}" class="text-decoration-none">{{ post.data.title }}</a>
            </h2>
            <time class="text-muted small d-inline-flex align-items-center">
              <i class="bi bi-calendar3 me-1" style="line-height: 0;"></i>{{ post.date | dateHuman }}
            </time>
            <hr>
            {% if post.data.description %}
              <p class="mt-2 mb-3">{{ post.data.description }}</p>
            {% endif %}
            <div class="mb-3 d-flex flex-wrap gap-2 align-items-center">
              <span class="fw-bold small">Altri tag:</span>
              {% set currentTags = post.data.strapiTags.split(",") %}
              {% for t in currentTags %}
                {% set cleanTag = t | trim %}
                {% if cleanTag != "posts" and cleanTag != tag and cleanTag != "" %}
                  <a href="/tags/{{ cleanTag | slugify }}/" class="badge bg-light border text-decoration-none" style="color: var(--bs-body-color); padding: 0.4em 0.6em; line-height: 1">{{ cleanTag }}</a>
                {% endif %}
              {% endfor %}
            </div>
            <div class="text-end mt-auto">
              <a href="{{ post.url }}" class="btn btn-primary btn-sm rounded px-3">
                Leggi l'articolo <i class="bi bi-arrow-right ms-1"></i>
              </a>
            </div>
          </div>
        </article>
      </li>
    {% endfor %}
  {% else %}
    <li class="text-center py-5">
      <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
      <p class="text-muted">Nessun articolo trovato per questo tag.</p>
      <a href="/blog/" class="btn btn-outline-primary">
        <i class="bi bi-arrow-left me-1"></i> Torna al blog
      </a>
    </li>
  {% endif %}
</ul>