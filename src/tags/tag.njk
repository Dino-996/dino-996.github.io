---
layout: page.njk
title: "Tag: {{ tag }}"
permalink: "/tags/{{ tag | slugify }}/index.html"
eleventyExcludeFromCollections: true
pagination:
  data: collections.tagList
  size: 1
  alias: tag
---

{% from "article-card.njk" import listCard %}

<div class="mb-6">
  <div class="mb-1">
    <a href="/blog/" class="text-muted small" style="text-decoration: none;">← Torna al blog</a>
  </div>
  <h1 class="font-headline-lg mb-1">
    Tag: <span style="color: var(--primary);">{{ tag }}</span>
  </h1>
  <p class="text-muted small mb-0">Post con tag "{{ tag }}"</p>
</div>

{% set taggedPosts = [] %}
{% for post in collections.posts %}
  {% set allTags = (post.data.strapiTags or "").split(",") %}
  {% if tag in allTags %}
    {% set taggedPosts = (taggedPosts.push(post), taggedPosts) %}
  {% endif %}
{% endfor %}

{% if taggedPosts.length > 0 %}
  {% for post in taggedPosts %}
  {{ listCard(post, { compact: true, truncate: 200, relatedTags: true, excludeTag: tag }) }}
  {% endfor %}
{% else %}
  <div style="text-align: center; padding: 64px 16px;">
    <p class="text-muted mb-3">Nessun articolo trovato per questo tag.</p>
    <a href="/blog/" class="btn btn-outline">Torna al blog</a>
  </div>
{% endif %}
