---
layout: page.njk
title: Home
---

{% from "article-card.njk" import gridCard %}

<div class="grid-12">
  <!-- Main content -->
  <div class="md-col-span-9">

    {% set allPosts = posts | default([]) %}
    {% set firstPost = allPosts | first %}

    {% if firstPost %}
    <!-- Featured Article -->
    <article class="featured-article mb-6">
      {% if firstPost.image %}
      <img src="{{ firstPost.image }}"
           alt="{{ firstPost.imageAlt | default(firstPost.title) }}"
           class="featured-article-image"
           loading="eager"
           fetchpriority="high">
      {% endif %}
      <div class="featured-article-content">
        {% if firstPost.strapiTags %}
          {% set topTag = firstPost.strapiTags.split(",") | first | trim %}
          {% if topTag and topTag != "posts" %}
          <a href="/tags/{{ topTag | slugify }}/" class="badge badge-category" style="align-self: flex-start;">{{ topTag }}</a>
          {% endif %}
        {% endif %}
        <h1 class="featured-article-title">
          <a href="{{ firstPost.url }}">{{ firstPost.title }}</a>
        </h1>
        {% if firstPost.description %}
        <p class="featured-article-excerpt">{{ firstPost.description }}</p>
        {% endif %}
        <div class="article-item-meta">
          <time datetime="{{ firstPost.date | dateIso }}">{{ firstPost.date | dateHuman }}</time>
          {% if firstPost.author %}
           · <span>{{ firstPost.author }}</span>
          {% endif %}
        </div>
      </div>
    </article>
    {% endif %}

    {% if allPosts | length > 1 %}
    <div class="section-divider">Ultimi articoli</div>

    <div class="article-grid mb-6">
      {% for post in allPosts %}
      {% if loop.index0 >= 1 and loop.index0 < 7 %}
      {{ gridCard(post) }}
      {% endif %}
      {% endfor %}
    </div>
    {% endif %}

    {% if allPosts | length == 0 %}
    <div style="text-align: center; padding: 64px 16px;">
      <p class="text-muted">Nessun articolo disponibile al momento.</p>
    </div>
    {% endif %}
  </div>

  <!-- Sidebar -->
  <aside class="sidebar-section md-col-span-3">
    <!-- About CTA -->
    <div class="cta-card">
      <img src="https://res.cloudinary.com/dcro2pbqr/image/upload/v1785267780/dino_transparent_af2b05ef49.png" alt="DinoSec" class="dino-cta-img">
      <h3>Ciao, sono Davide</h3>
      <p>Condivido qui articoli su development, networking e cybersecurity.</p>
      <div class="d-flex gap-2" style="width: 100%;">
        <a href="/about/" class="btn btn-primary" style="flex: 1;">Chi sono</a>
        <a href="/courses/" class="btn btn-outline" style="flex: 1;">Percorsi</a>
      </div>
    </div>

    {% if allPosts | length > 0 %}
    <!-- Intanto -->
      <div class="sidebar-card">
      <div class="sidebar-card-title" style="font-size: 1rem;">Intanto</div>
      {% for post in allPosts %}
      {% if loop.index0 < 4 %}
      <div class="sidebar-news-item">
        <a href="{{ post.url }}">{{ post.title }}</a>
        <div class="date">{{ post.date | dateHuman }}</div>
      </div>
      {% endif %}
      {% endfor %}
    </div>
    {% endif %}

    <!-- Newsletter -->
    <div class="newsletter-box">
      <div class="icon">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
          <polyline points="22,6 12,13 2,6"/>
        </svg>
      </div>
      <h3>Newsletter</h3>
      <p>Ricevi aggiornamenti sui nuovi articoli direttamente via email.</p>
      <div class="newsletter-input">
        <label for="newsletter-email" class="visually-hidden">Indirizzo email</label>
        <input type="email" placeholder="La tua email" id="newsletter-email">
        <button class="btn btn-primary" id="newsletter-submit">Iscriviti</button>
      </div>
      <div id="newsletter-message" class="newsletter-message" hidden aria-live="polite"></div>
    </div>
  </aside>
</div>
